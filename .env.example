# Fill in a provider's key and that provider turns on. Fill in nothing and the app uses the offline mock triager.
# Default provider (anthropic | openai | gemini | ollama | compat); blank = the first one that is configured.
LLM_PROVIDER=

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-sol

# Google Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Ollama (local, free): install Ollama, `ollama pull <model>`, then put the model name here
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any OpenAI-compatible server: OpenRouter, Groq, LM Studio, vLLM...
# e.g. OpenRouter: OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_LABEL=OpenRouter
